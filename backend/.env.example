# Copy to backend/.env and fill in. Never commit .env.
#
# The AI analyst works with any free, OpenAI-compatible LLM provider.
# Pick ONE provider:
#
#   gemini      Google Gemini free tier  - key: https://aistudio.google.com/apikey  (recommended: vision + tools)
#   groq        Groq free tier           - key: https://console.groq.com/keys
#   openrouter  OpenRouter free models   - key: https://openrouter.ai/keys
#   ollama      Local, fully offline     - no key; install https://ollama.com then `ollama pull <model>`
#   custom      Any OpenAI-compatible endpoint (also set AI_BASE_URL)

AI_PROVIDER=gemini
AI_API_KEY=

# Optional: override the provider's default model (names change; check the provider's model list)
# AI_MODEL=gemini-2.5-flash

# Optional: set to false if your model can't read images
# AI_VISION=true

# Only for AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:1234/v1
